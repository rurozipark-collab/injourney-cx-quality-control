# ============================================
# InJourney Airports CX Quality Control
# Environment Configuration
# ============================================

# --- LLM Provider for Knowledge Base Chat ---
# Options: "openai" or "ollama"
LLM_PROVIDER=openai

# --- OpenAI Configuration (Recommended for best quality) ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini          # or gpt-3.5-turbo, gpt-4o

# --- Ollama Configuration (Local, no cost) ---
# Only used if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b          # or mistral, gemma2, etc.

# --- Embeddings ---
# "openai" (best) or "local" (sentence-transformers, works offline)
EMBEDDING_PROVIDER=local

# If using OpenAI embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Application Settings ---
APP_NAME="InJourney Airports CX Quality Control"
DEBUG=false

# --- Optional: Custom Chroma persist directory ---
# CHROMA_PERSIST_DIR=./chroma_db
